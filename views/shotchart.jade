            p Since we have the data on LeBron James' shots, I figured we could break down each shot into the categories to see how he is scoring his buckets.
            div.input
                div.prompt.input_prompt
                | In&nbsp;[7]:
                div.inner_cell
                    div.input_area
                        div.highlight.hl-ipython3
                        pre
                            span
                            span.c1 #combine shot types
                            br
                            span.n all_shots
                            span.p [
                            span.s1 'COMBINED_SHOT_TYPE'
                            span.p ]
                            span.o =
                            span.n all_shots
                            span.p [
                            span.s1 'ACTION_TYPE'
                            span.p ]
                            br
                            br
                            span.n all_shots
                            span.o .
                            span.n replace
                            span.p (
                            span.n to_replace
                            span.o =
                            span.p {
                            br
                            | &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            span.s1 'COMBINED_SHOT_TYPE'
                            span.p :{
                            br
                            | &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            span.s1 '(.+)?Jump (.+)?(S|s)hot'
                            span.p :
                            span.s1 'Jump Shot'
                            span.p ,
                            br
                            | &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            span.s1 '(.+)?Fadeaway(.+)?'
                            span.p :
                            span.s1 'Jump Shot'
