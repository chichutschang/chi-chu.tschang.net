                                | &nbsp;
                                span.ow in
                                | &nbsp;
                                span.nb range
                                span.p (
                                span.mi 1996
                                span.p ,
                                span.mi 2016
                                span.p ):
                                br
                                | &nbsp;&nbsp;&nbsp;&nbsp;
                                span.c1 #the stats.nba.com API wants season as "1996-97"
                                br
                                | &nbsp;&nbsp;&nbsp;&nbsp;
                                span.n seasonString
                                | &nbsp;
                                span.o =
                                | &nbsp;
                                span.nb str
                                span.p (
                                span.n season
                                span.p )
                                | &nbsp;
                                span.o +
                                | &nbsp;
                                span.s1 '-'
                                | &nbsp;
                                span.o +
                                span.nb str
                                span.p (
                                span.n season
                                span.o +
                                span.mi 1
                                span.p )[
                                span.mi 2
                                span.p :]
                                br
                                | &nbsp;&nbsp;&nbsp;&nbsp;
                                span.n shot_chart_url
                                span.o =
                                span.s1 'http://stats.nba.com/stats/shotchartdetail?CFID=33&amp;CFPARAMS='
                                span.o +
